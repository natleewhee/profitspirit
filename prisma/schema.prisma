generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Theme {
  AI_INFRA_SEMIS
  NON_TECH_ASYMMETRIC
  SGX
  OTHER
}

enum Status {
  NEW
  RESEARCHED
  ADDED_TO_WATCHLIST
  ADDED_TO_PORTFOLIO
  PASSED
}

enum ConfidenceRead {
  LOW
  MEDIUM
  HIGH
}

// Derived deterministically from recommendationScore (score.ts) — not an
// independent LLM choice, so it can never contradict the score.
enum Recommendation {
  WATCH
  RESEARCH_FURTHER
  PASS
}

// LLM-judged, grounded in explicit risk signals fed into the Synthesizer
// prompt (debt/liquidity ratios, price volatility) — see agents.ts.
enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

// Deterministic, computed by valuation.ts from currentPrice vs
// fairValueEstimate — not an LLM judgment.
enum ValuationVerdict {
  UNDERVALUED
  OVERVALUED
  FAIRLY_VALUED
  INSUFFICIENT_DATA
}

// How much data the two analysts actually had to work with — distinct from
// ConfidenceRead, which is the Synthesizer's read on how clear the signal
// is. Computed deterministically from the fetched data, not judged by the LLM.
enum DataQuality {
  THIN
  ADEQUATE
  RICH
}

model Candidate {
  id            String      @id @default(cuid())
  ticker        String
  dateScanned   DateTime
  theme         Theme
  triggerReason String
  status        Status      @default(NEW)
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  scorecards    Scorecard[]
}

// Phase 2 — one row per research-agent run (docs/research-agent-scope.md §5).
// A candidate can be re-researched over time, so this is a history, not a 1:1.
model Scorecard {
  id                  String           @id @default(cuid())
  candidateId         String
  candidate           Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  asOf                DateTime
  fundamentalsSummary String
  technicalsSummary   String
  bullCase            String
  bearCase            String
  confidenceRead      ConfidenceRead
  riskFlags           String[]
  recommendation      Recommendation
  entryPriceEstimate  Float?
  fairValueEstimate   Float?
  targetsBasis        String
  currentPrice        Float?
  sector              String?
  industry            String?
  dataQuality         DataQuality
  riskLevel           RiskLevel
  valuationVerdict    ValuationVerdict
  recommendationScore Int?
  createdAt           DateTime         @default(now())

  @@index([candidateId])
}
