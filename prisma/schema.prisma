generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Theme {
  AI_INFRA_SEMIS
  NON_TECH_ASYMMETRIC
  SGX
  OTHER
}

enum Status {
  NEW
  RESEARCHED
  ADDED_TO_WATCHLIST
  ADDED_TO_PORTFOLIO
  PASSED
}

enum ConfidenceRead {
  LOW
  MEDIUM
  HIGH
}

enum Recommendation {
  WATCH
  RESEARCH_FURTHER
  PASS
}

model Candidate {
  id            String      @id @default(cuid())
  ticker        String
  dateScanned   DateTime
  theme         Theme
  triggerReason String
  status        Status      @default(NEW)
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  scorecards    Scorecard[]
}

// Phase 2 — one row per research-agent run (docs/research-agent-scope.md §5).
// A candidate can be re-researched over time, so this is a history, not a 1:1.
model Scorecard {
  id                  String         @id @default(cuid())
  candidateId         String
  candidate           Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  asOf                DateTime
  fundamentalsSummary String
  technicalsSummary   String
  bullCase            String
  bearCase            String
  confidenceRead      ConfidenceRead
  riskFlags           String[]
  recommendation      Recommendation
  entryPriceEstimate  Float?
  fairValueEstimate   Float?
  targetsBasis        String
  createdAt           DateTime       @default(now())

  @@index([candidateId])
}
