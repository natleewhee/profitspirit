generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations need a direct (non-pooled) connection — Supabase's pgbouncer
  // pooler on DATABASE_URL doesn't support the transaction modes `migrate
  // deploy` requires. The app's runtime queries keep using DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

enum Theme {
  AI_INFRA_SEMIS
  NON_TECH_ASYMMETRIC
  SGX
  OTHER
}

enum Status {
  NEW
  RESEARCHED
  ADDED_TO_WATCHLIST
  ADDED_TO_PORTFOLIO
  PASSED
}

enum ConfidenceRead {
  LOW
  MEDIUM
  HIGH
}

// Derived deterministically from recommendationScore (score.ts) — not an
// independent LLM choice, so it can never contradict the score.
enum Recommendation {
  WATCH
  RESEARCH_FURTHER
  PASS
}

// Derived deterministically from riskScore (risk.ts) via fixed thresholds —
// not an LLM judgment. See Scorecard.riskScore.
enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

// Deterministic, computed by valuation.ts from currentPrice vs
// fairValueEstimate — not an LLM judgment.
enum ValuationVerdict {
  UNDERVALUED
  OVERVALUED
  FAIRLY_VALUED
  INSUFFICIENT_DATA
}

// How much data the two analysts actually had to work with — distinct from
// ConfidenceRead, which is the Synthesizer's read on how clear the signal
// is. Computed deterministically from the fetched data, not judged by the LLM.
enum DataQuality {
  THIN
  ADEQUATE
  RICH
}

model Candidate {
  id            String      @id @default(cuid())
  ticker        String
  dateScanned   DateTime
  // Optional now — the add-candidate flow is ticker-only (see AddCandidateModal);
  // theme/triggerReason survive as later-editable annotations, not required input.
  theme         Theme?
  triggerReason String?
  status        Status      @default(NEW)
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  scorecards    Scorecard[]
}

// Phase 2 — one row per research-agent run (docs/research-agent-scope.md §5).
// A candidate can be re-researched over time, so this is a history, not a 1:1.
model Scorecard {
  id                   String           @id @default(cuid())
  candidateId          String
  candidate            Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  asOf                 DateTime
  fundamentalsSummary  String
  technicalsSummary    String
  bullCase             String
  bearCase             String
  confidenceRead       ConfidenceRead
  riskFlags            String[]
  recommendation       Recommendation
  entryPriceEstimate   Float?
  fairValueEstimate    Float?
  targetsBasis         String
  currentPrice         Float?
  sector               String?
  industry             String?
  dataQuality          DataQuality
  riskLevel            RiskLevel
  valuationVerdict     ValuationVerdict
  // Composite 0-100: weighted blend of valuationScore, qualityScore, and
  // risk, damped by confidence. See score.ts.
  recommendationScore  Int?
  // Pure cheapness, 0-100 (100 = deeply undervalued, 0 = deeply overvalued).
  // Deliberately separate from recommendationScore — otherwise a value trap
  // (cheap + bad business) and a genuine bargain look identical. See gap.ts.
  valuationScore       Int?
  // Business-quality composite, 0-100, from ROE/margins/revenue growth/FCF.
  // See quality.ts. Null when too little fundamentals data to compute.
  qualityScore         Int?
  // 1 (low risk) - 5 (high risk), deterministic from leverage, liquidity,
  // and price volatility. riskLevel above is derived from this. See risk.ts.
  riskScore            Int?
  // Suggested buy zone — fairValueEstimate with a 20-30% margin of safety
  // band, replacing the old single-point entryPriceEstimate with a range.
  // entryPriceEstimate is kept as the band's midpoint for backward compat.
  entryZoneLow         Float?
  entryZoneHigh        Float?
  marketCap            Float?
  fiftyTwoWeekHigh     Float?
  fiftyTwoWeekLow      Float?
  fiftyDayAverage      Float?
  twoHundredDayAverage Float?
  nextEarningsDate     DateTime?
  // Hover-preview panel fields — all already fetched from Yahoo elsewhere in
  // the pipeline (trailingPE/forwardPE via marketData.ts, earningsGrowth via
  // fundamentalsData.ts) or cheap additions from modules already called
  // (dividendYield off the base quote, analystTargetPrice off financialData).
  // Distinct from our own fairValueEstimate — this is Yahoo's analyst
  // consensus, not our computed figure.
  trailingPE           Float?
  forwardPE            Float?
  earningsGrowth       Float?
  dividendYield        Float?
  analystTargetPrice   Float?
  createdAt            DateTime         @default(now())

  @@index([candidateId])
}
